# ─────────────────────────────────────────────────────────────
# Kopieren nach .env (lokal) bzw. als Secrets in Cloudflare Pages
# eintragen. Echte Werte NIE ins Repo committen.
# Variablen mit PUBLIC_ landen im Browser – dort keine Geheimnisse!
# ─────────────────────────────────────────────────────────────

# ── Beds24 (Phase 4: Verfügbarkeit & Buchung) ────────────────
# Refresh-Token für API v2. Erstellen: Beds24 → Settings → Marketplace →
# API → Invite Code generieren, einmalig gegen Refresh-Token tauschen.
# Rechte: read inventory, read properties (später: write bookings).
# Ein Token gilt für alle Wohnungen im Beds24-Konto. Die IDs pro Wohnung
# stehen in src/content/wohnungen/<wohnung>.md (Feld beds24).
BEDS24_REFRESH_TOKEN=

# ── Stripe (Phase 5: Shop-Zahlungen) ─────────────────────────
# Dashboard → Developers → API keys. Für Tests sk_test_… verwenden.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → Endpoint /api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# ── Gelato (Phase 5: Print-on-Demand) ────────────────────────
# Gelato Dashboard → Developer → API Keys
GELATO_API_KEY=
GELATO_STORE_ID=
# Selbst gewählte Zufallszeichenfolge, wird an die Webhook-URL gehängt
# (/api/gelato-webhook?token=…), damit nur Gelato Statusmeldungen senden kann.
# Erzeugen z. B. mit: openssl rand -hex 32
GELATO_WEBHOOK_TOKEN=

# ── E-Mail (Bestellbestätigungen, Packlisten fürs Kleinlager) ─
# resend.com → API Keys (Domain alpine-siesta.ch dort verifizieren)
RESEND_API_KEY=
MAIL_FROM="Alpine Siesta <hallo@alpine-siesta.ch>"
# Empfänger der Packlisten für Magnete & Kugelschreiber
MAIL_BESTELLUNGEN_AN=

# ── Öffentlich (im Browser sichtbar) ─────────────────────────
PUBLIC_KONTAKT_EMAIL=hallo@alpine-siesta.ch
# Cookielose Statistik, leer lassen = deaktiviert
PUBLIC_PLAUSIBLE_DOMAIN=

# ── Build & Betrieb (nur CI, nicht in der App) ───────────────
# Cloudflare Pages → Settings → Builds → Deploy hooks.
# Wird nachts aufgerufen, um Gelato-Produkte neu zu laden.
DEPLOY_HOOK_URL=
