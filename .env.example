# ─────────────────────────────────────────────────────────────
# Lokale Werte (localhost) nach .env.local. Echte Werte nie committen.
# PUBLIC_… landet im Browser (Buchungs-Widget). Für Entdecken-SSR
# bevorzugt Server-Variablen (TRIZOUN_…) – die bleiben aus dem HTML.
# Geheimnisse (Beds24, Stripe, Gelato, Mail) liegen in Trizoun Travel, nicht hier.
# ─────────────────────────────────────────────────────────────

# Trizoun Travel (Buchung, Kontakt, Entdecken-SSR). Anleitung: docs/TRIZOUN.md
# Publishable Key (tt_pk_…) im Dashboard; Origins freigeben (lokal http://127.0.0.1:4321, live https://alpine-siesta.ch).
# Lokal: http://127.0.0.1:8787 und der Publishable Key aus dem Dashboard.
PUBLIC_TRIZOUN_API_URL=
PUBLIC_TRIZOUN_KEY=

# Entdecken-SSR (optional, empfohlen). Fallback = PUBLIC_TRIZOUN_*.
# Zur Laufzeit in Docker/Compose setzen; Key erscheint nicht im Client-Bundle der Filter-JS.
TRIZOUN_API_URL=
TRIZOUN_KEY=

# Cookielose Statistik, leer = deaktiviert
PUBLIC_PLAUSIBLE_DOMAIN=

# Inhalte prüfen: Entwürfe trotzdem bauen (nur zur Kontrolle, nie für den Livegang)
# PUBLIC_ENTWUERFE=true
