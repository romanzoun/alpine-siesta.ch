# ─────────────────────────────────────────────────────────────
# Kopieren nach .env. Echte Werte nie committen.
# Die Website ist statisch: Alle Werte hier landen im Browser (PUBLIC_…).
# Geheimnisse (Beds24, Stripe, Gelato, Mail) liegen in Trizoun Travel, nicht hier.
# ─────────────────────────────────────────────────────────────

# Online-Buchung über Trizoun Travel (dort ist Beds24 verbunden).
# Publishable Key (tt_pk_…) im Trizoun-Dashboard erstellen und auf die Domain der Website beschränken.
# Leer lassen = Buchungs-Widget zeigt die Mail-Anfrage.
PUBLIC_TRIZOUN_API_URL=
PUBLIC_TRIZOUN_KEY=

# Cookielose Statistik, leer = deaktiviert
PUBLIC_PLAUSIBLE_DOMAIN=

# Inhalte prüfen: Entwürfe trotzdem bauen (nur zur Kontrolle, nie für den Livegang)
# PUBLIC_ENTWUERFE=true
