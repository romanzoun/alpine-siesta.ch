---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Fakten from '../../components/Fakten.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { alleWohnungen, wohnungUrl } from '../../lib/wohnungen';
import { site } from '../../config';
import { asLocale, mitLocale, type Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import { wohnungLocale } from '../../i18n/wohnung';

const locale = asLocale((Astro.props as { locale?: Locale }).locale ?? Astro.currentLocale);
const t = ui(locale);
const wohnungen = await alleWohnungen();
---

<Base locale={locale} title={`${t.unsereWohnungen(site.ort)} | ${site.name}`} description={t.unsereWohnungenLead(site.name, site.ort)}>
  <section class="section container">
    <Breadcrumbs pfad={[{ name: t.wohnungen, href: mitLocale(locale, '/wohnungen/') }]} />
    <h1>{t.unsereWohnungenH1}</h1>
    <div class="liste">
      {wohnungen.map(({ id, data: w }) => {
        const lokal = wohnungLocale(locale);
        return (
        <article>
          <a href={wohnungUrl(id, locale)}><Image src={w.galerie[0].bild} alt={lokal?.bilder[0]?.alt ?? w.galerie[0].alt} widths={[480, 900]} sizes="(min-width: 48rem) 50vw, 100vw" /></a>
          <h2><a href={wohnungUrl(id, locale)}>{w.name}</a></h2>
          <p class="lead">{lokal?.claim ?? w.claim}</p>
          <Fakten fakten={w.fakten} locale={locale} />
        </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .liste { grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); }
  img { border-radius: var(--radius); aspect-ratio: 3 / 2; object-fit: cover; width: 100%; margin-bottom: 1.25rem; }
  h2 a { color: inherit; text-decoration: none; }
</style>
