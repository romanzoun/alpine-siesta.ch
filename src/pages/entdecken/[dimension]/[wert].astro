---
export const prerender = false;

import { getEntry, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { site } from '../../../config';
import { asLocale } from '../../../i18n/config';
import { fetchRegion, KatalogFehler } from '../../../modules/entdecken/api';
import EntdeckenUebersicht from '../../../modules/entdecken/components/EntdeckenUebersicht.astro';
import EntdeckenThemenLinks from '../../../modules/entdecken/components/EntdeckenThemenLinks.astro';
import { dimensionen, pfadZuDimension, themenH1, themenUrl, type DimensionKey } from '../../../modules/entdecken/dimensionen';

interface Props { locale?: string }

if (!site.module.entdecken) return new Response(null, { status: 404 });
const sprache = asLocale(Astro.props.locale ?? Astro.currentLocale);

const d = pfadZuDimension(Astro.params.dimension ?? '');
const wert = Astro.params.wert ?? '';
if (!d || !wert || !(wert in dimensionen[d].werte)) return new Response(null, { status: 404 });

let alle;
try {
  alle = await fetchRegion(sprache);
} catch (err) {
  if (err instanceof KatalogFehler && (err.status === 403 || err.status === 401)) return new Response(null, { status: 404 });
  throw err;
}

const treffer = alle.filter((a) => dimensionen[d].passt(a, wert));
if (!treffer.length) return new Response(null, { status: 404 });

const eigen = await getEntry('themenseiten', `${dimensionen[d].pfad}-${wert}`);
const { Content } = eigen ? await render(eigen) : { Content: null };

const h1 = eigen?.data.h1 ?? themenH1(d, wert);
const title = eigen?.data.title ?? `${h1}: ${treffer.length} ${treffer.length === 1 ? 'Tipp' : 'Tipps'} | ${site.name}`;
const description =
  eigen?.data.description ??
  `${h1}: ${treffer.slice(0, 3).map((a) => a.title.split(' – ')[0]).join(', ')} und mehr. Ausgewählt von deinen Gastgebern in ${site.ort}.`.replace(/^(.{0,157})\s.*$/s, '$1 …');
const intro = eigen?.data.intro ?? `Unsere ${treffer.length === 1 ? 'Empfehlung' : `${treffer.length} Empfehlungen`} – ausgewählt von uns als Gastgeber.`;
const href = themenUrl(d as DimensionKey, wert);
const filterLink = d === 'saison' ? '/entdecken/' : `/entdecken/?${d === 'fuer' ? 'fuer' : 'thema'}=${wert}`;
---

<Base title={title} description={description} locale={sprache}>
  <section class="section container">
    <Breadcrumbs pfad={[{ name: 'Entdecken', href: '/entdecken/' }, { name: h1, href }]} />
    <h1>{h1}</h1>
    <p class="lead">{intro}</p>
    {Content && <div class="prose"><Content /></div>}
    <p><a href={filterLink}>Alle Aktivitäten selbst filtern</a></p>
    <EntdeckenUebersicht eintraege={treffer} sprache={sprache} />
  </section>
  <section class="section container">
    <h2>Weitere Themen</h2>
    <EntdeckenThemenLinks eintraege={alle} aktuell={href} />
  </section>
</Base>
