---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { site } from '../../config';
import { asLocale } from '../../i18n/config';
import { fetchEintrag, fetchRegion, KatalogFehler } from '../../modules/entdecken/api';
import EntdeckenDetail from '../../modules/entdecken/components/EntdeckenDetail.astro';

interface Props { locale?: string }

if (!site.module.entdecken) return new Response(null, { status: 404 });
const sprache = asLocale(Astro.props.locale ?? Astro.currentLocale);

const slug = Astro.params.slug;
if (!slug || ['saison', 'fuer', 'thema', 'bild', 'bilder', 'inhalt'].includes(slug)) {
  return new Response(null, { status: 404 });
}

let eintrag;
try {
  eintrag = await fetchEintrag(slug, sprache);
} catch (err) {
  if (err instanceof KatalogFehler) return new Response(null, { status: err.status === 404 ? 404 : err.status === 403 || err.status === 401 ? 404 : 502 });
  throw err;
}

let aehnlich = [];
try {
  const alle = await fetchRegion(sprache);
  aehnlich = alle
    .filter((x) => x.slug !== eintrag.slug)
    .map((x) => ({
      x,
      score: x.kategorien.filter((k) => eintrag.kategorien.includes(k)).length + (x.pillar === eintrag.pillar ? 1 : 0),
    }))
    .filter((s) => s.score > 0)
    .sort((p, q) => q.score - p.score)
    .slice(0, 3)
    .map((s) => s.x);
} catch {
  aehnlich = [];
}
---

<Base title={`${eintrag.title} | ${site.name}`} description={eintrag.description} locale={sprache}>
  <EntdeckenDetail eintrag={eintrag} aehnlich={aehnlich} sprache={sprache} />
</Base>
