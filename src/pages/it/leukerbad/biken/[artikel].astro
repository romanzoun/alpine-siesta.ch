---
import { getCollection } from 'astro:content';
import ArtikelSeite from '../../../../views/ArtikelSeite.astro';
import { bikenArtikelIds } from '../../../../i18n/biken';

export async function getStaticPaths() {
  const alle = await getCollection('artikel');
  return bikenArtikelIds.flatMap((id) => {
    const a = alle.find((eintrag) => eintrag.id === id && !eintrag.data.entwurf);
    return a ? [{ params: { artikel: id.split('/')[1] }, props: { a } }] : [];
  });
}

const { a } = Astro.props;
---

<ArtikelSeite a={a} pillarH1="In bici" locale="it" />
