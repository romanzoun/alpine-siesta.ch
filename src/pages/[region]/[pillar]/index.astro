---
import PillarSeite from '../../../views/PillarSeite.astro';
import { allePillars, type Pillar } from '../../../lib/pillars';
import { site } from '../../../config';

export async function getStaticPaths() {
  return (await allePillars()).map((p) => ({ params: { region: site.seoPfad, pillar: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: Pillar };
---

<PillarSeite p={p} />
