---
// Pillar Page, z. B. /leukerbad/thermen/
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import AktivitaetenListe from '../../../components/AktivitaetenListe.astro';
import BuchungsBand from '../../../components/BuchungsBand.astro';
import { allePillars, artikelVon, pillarUrl, artikelUrl, hubUrl, type Pillar } from '../../../lib/pillars';
import { sortiert } from '../../../lib/entdecken';
import { site } from '../../../config';

export async function getStaticPaths() {
  return (await allePillars()).map((p) => ({ params: { region: site.seoPfad, pillar: p.id }, props: { p } }));
}

const { p } = Astro.props as { p: Pillar };
const { Content } = await render(p);
const artikel = await artikelVon(p.id);
const aktivitaeten = sortiert(await getCollection('aktivitaeten', (a) => a.data.pillar === p.id));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: p.data.h1,
  description: p.data.description,
  author: { '@type': 'Organization', name: site.name, url: site.domain },
  ...(p.data.bild && { image: new URL(p.data.bild.src, Astro.site).href }),
};
---

<Base title={p.data.title} description={p.data.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="section container">
    <Breadcrumbs pfad={[{ name: site.ort, href: hubUrl() }, { name: site.pillars[p.id as keyof typeof site.pillars], href: pillarUrl(p.id) }]} />
    {p.data.entwurf && <p class="entwurf">Entwurf – nicht öffentlich</p>}
    <h1>{p.data.h1}</h1>
    <p class="lead">{p.data.lead}</p>
    {p.data.bild && <Image src={p.data.bild} alt={p.data.bild_alt!} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" class="titelbild" />}
    <div class="prose"><Content /></div>
  </article>

  {artikel.length > 0 && (
    <section class="section container">
      <h2>Mehr zum Thema</h2>
      <div class="liste">
        {artikel.map((a) => (
          <article>
            <h3><a href={artikelUrl(a.id)}>{a.data.h1}</a></h3>
            <p class="muted">{a.data.kurz}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {aktivitaeten.length > 0 && (
    <section class="section container">
      <h2>Passende Aktivitäten</h2>
      <AktivitaetenListe aktivitaeten={aktivitaeten} />
    </section>
  )}

  <BuchungsBand />
</Base>

<style>
  .titelbild { border-radius: var(--radius); margin-block: 1rem 2.5rem; width: 100%; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .entwurf { display: inline-block; background: var(--glut); color: var(--nacht); padding: .2rem .6rem; border-radius: var(--radius); font-weight: 650; }
</style>
