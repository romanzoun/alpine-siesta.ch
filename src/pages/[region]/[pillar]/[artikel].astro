---
import ArtikelSeite from '../../../views/ArtikelSeite.astro';
import { allePillars, artikelVon, type Artikel } from '../../../lib/pillars';
import { site } from '../../../config';

export async function getStaticPaths() {
  const pillars = await allePillars();
  const pfade = await Promise.all(
    pillars.map(async (p) =>
      (await artikelVon(p.id)).map((a) => ({
        params: { region: site.seoPfad, pillar: p.id, artikel: a.id.split('/')[1] },
        props: { a, pillarH1: p.data.h1 },
      })),
    ),
  );
  return pfade.flat();
}

const { a, pillarH1 } = Astro.props as { a: Artikel; pillarH1: string };
---

<ArtikelSeite a={a} pillarH1={pillarH1} />
