---
import { getCollection } from 'astro:content';
import ArtikelSeite from '../../../../views/ArtikelSeite.astro';
import { familieArtikelIds } from '../../../../i18n/familie-artikel';

export async function getStaticPaths() {
  const alle = await getCollection('artikel');
  return familieArtikelIds.flatMap((id) => {
    const a = alle.find((eintrag) => eintrag.id === id && !eintrag.data.entwurf);
    return a ? [{ params: { artikel: id.split('/')[1] }, props: { a } }] : [];
  });
}

const { a } = Astro.props;
---

<ArtikelSeite a={a} pillarH1="Family holidays" locale="en" />
