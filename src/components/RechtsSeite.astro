---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { asLocale, mitLocale, type Locale } from '../i18n/config';
import { rechtText } from '../i18n/recht';

interface Props {
  id: string;
  locale?: Locale;
}
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale);
const eintrag = await getEntry('rechtliches', Astro.props.id);
if (!eintrag) throw new Error(`site/rechtliches/${Astro.props.id}.md fehlt`);
const { Content } = await render(eintrag);
const text = rechtText(locale, eintrag.id);
const title = text?.title ?? eintrag.data.title;
const description = text?.description ?? eintrag.data.description;
---

<Base locale={locale} title={title} description={description}>
  <article class="section container">
    <Breadcrumbs pfad={[{ name: title, href: mitLocale(locale, `/${eintrag.id}/`) }]} />
    <h1>{title}</h1>
    {text?.deutsch && <p class="hinweis-sprache">{text.deutsch}</p>}
    <div class="prose" lang={text?.deutsch ? 'de-CH' : undefined}>
      {text && !text.deutsch ? text.bloecke.map((block) => (
        <section>
          {block.titel && <h2>{block.titel}</h2>}
          {block.absatz.map((p) => <p>{p}</p>)}
        </section>
      )) : <Content />}
    </div>
  </article>
</Base>

<style>
  .hinweis-sprache { padding: .75rem 1rem; border-left: 3px solid var(--accent); max-width: 40rem; }
</style>
