---
// Kontakt-/Buchungsanfrage. Mit site.kontakt.endpunkt: POST als JSON an das Backend.
// Ohne Endpunkt (Phase 1): öffnet eine vorausgefüllte E-Mail an site.email – kein Server nötig.
import { site } from '../config';
import { trizoun } from '../lib/trizoun';
import { alleWohnungen } from '../lib/wohnungen';
import { asLocale, mitLocale, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props {
  // vorgewählte Wohnung (Ordnername); ohne Angabe Auswahl bei mehreren Wohnungen
  wohnung?: string;
  // mit Anreise/Abreise/Gäste (Buchungsanfrage) oder nur Nachricht
  daten?: boolean;
  maxGaeste?: number;
  locale?: Locale;
}
const { wohnung, daten = true, maxGaeste = 8 } = Astro.props;
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale);
const t = ui(locale);
const wohnungen = (await alleWohnungen()).map((w) => ({ id: w.id, name: w.data.name }));
// Ordnername → Kurzname in Trizoun Travel
const slugs = Object.fromEntries((await alleWohnungen()).map((w) => [w.id, w.data.trizounSlug ?? w.id]));
const heute = new Date().toISOString().slice(0, 10);
---

<form class="anfrage" method="post" action={site.kontakt.endpunkt || `mailto:${site.email}`} enctype={site.kontakt.endpunkt ? undefined : 'text/plain'} data-anfrage>
  {wohnung || wohnungen.length === 1 ? (
    <input type="hidden" name="wohnung" value={wohnung ?? wohnungen[0]?.id} />
  ) : (
    <label class="feld">
      {t.wohnung}
      <select name="wohnung">
        <option value="">{t.nochOffen}</option>
        {wohnungen.map((w) => <option value={w.id}>{w.name}</option>)}
      </select>
    </label>
  )}
  {daten && (
    <div class="reihe">
      <label class="feld">{t.anreise}<input type="date" name="anreise" min={heute} /></label>
      <label class="feld">{t.abreise}<input type="date" name="abreise" min={heute} /></label>
    </div>
    <div class="reihe">
      <label class="feld">{t.erwachsene}
        <select name="erwachsene">
          {Array.from({ length: maxGaeste }, (_, i) => <option value={i + 1} selected={i + 1 === Math.min(2, maxGaeste)}>{i + 1}</option>)}
        </select>
      </label>
      <label class="feld">{t.kinder}
        <select name="kinder">
          {Array.from({ length: maxGaeste }, (_, i) => <option value={i}>{i}</option>)}
        </select>
      </label>
    </div>
  )}
  <label class="feld">Name<input name="name" required maxlength="100" autocomplete="name" /></label>
  <label class="feld">E-Mail<input type="email" name="email" required maxlength="200" autocomplete="email" /></label>
  <label class="feld">{daten ? t.nachrichtOptional : t.nachricht}<textarea name="nachricht" rows="4" maxlength="5000" required={!daten}></textarea></label>
  <!-- Falle für Spam-Bots: Menschen sehen dieses Feld nicht -->
  <label class="falle" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
  <input type="hidden" name="t" value="" />
  <!-- Nur sichtbar, wenn der Vermieter in Trizoun Gäste-Post nutzt -->
  <label class="haken" data-angebote hidden><input type="checkbox" name="angebote" /><span>{t.angeboteEinwilligung.replace('{name}', site.name)}</span></label>
  <p class="hinweis">{t.datenschutzHinweis} <a href={mitLocale(locale, '/datenschutz/')}>{t.datenschutz}</a></p>
  <button class="btn" type="submit" data-senden={t.anfrageSenden}>{site.kontakt.endpunkt ? t.anfrageSenden : t.mailVorbereiten}</button>
  <p class="status" data-status role="status" aria-live="polite"></p>
</form>

<script define:vars={{ slugs, email: site.email, endpunkt: site.kontakt.endpunkt, trizounApi: trizoun.apiUrl ?? '', trizounKey: trizoun.key ?? '', name: site.name, texte: { davonKinder: t.davonKinder, anreise: t.anreise, abreise: t.abreise, gaeste: t.gaeste, mailOeffnet: t.mailOeffnet, wirdGesendet: t.wirdGesendet, danke: t.danke, nichtGeklappt: t.nichtGeklappt, anfrage: t.anfragen } }}>
  document.querySelectorAll('[data-anfrage]').forEach((form) => {
    form.querySelector('[name="t"]').value = String(Math.floor(Date.now() / 1000));
    const status = form.querySelector('[data-status]');
    const anreise = form.querySelector('[name="anreise"]');
    const abreise = form.querySelector('[name="abreise"]');
    anreise?.addEventListener('change', () => { if (abreise) abreise.min = anreise.value; });
    // Ist die E-Mail-Buchung der Wohnung in Trizoun eingeschaltet, geht das Formular an die API, sonst in die Mail-App.
    const fest = form.querySelector('input[type="hidden"][name="wohnung"]')?.value;
    if (trizounApi && trizounKey && fest) {
      const knopf = form.querySelector('button[type="submit"]');
      knopf.disabled = true;
      fetch(`${trizounApi}/v1/public/listings/${encodeURIComponent(slugs[fest] ?? fest)}`, { headers: { authorization: `Bearer ${trizounKey}` } })
        .then((res) => (res.ok ? res.json() : {}))
        .then((json) => {
          if (!json.data?.features?.emailBuchung) return;
          form.dataset.versand = 'trizoun';
          if (json.data.features.gaestePost) form.querySelector('[data-angebote]').hidden = false;
          if (knopf.dataset.senden) knopf.textContent = knopf.dataset.senden;
        })
        .catch(() => {})
        .finally(() => { knopf.disabled = false; });
    }
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = Object.fromEntries(new FormData(form));
      if (f.website) return; // Spam-Falle
      const kinder = Number(f.kinder || 0);
      if (f.erwachsene) f.gaeste = String(Number(f.erwachsene) + kinder);
      const mailto = () => {
        const zeilen = [
          ...(f.anreise ? [`${texte.anreise}: ${f.anreise}`] : []),
          ...(f.abreise ? [`${texte.abreise}: ${f.abreise}`] : []),
          ...(f.gaeste && f.anreise ? [`${texte.gaeste}: ${f.gaeste}${kinder ? `, ${texte.davonKinder.replace('{n}', kinder)}` : ''}`] : []),
          '',
          f.nachricht,
          '',
          f.name,
        ];
        const betreff = `${texte.anfrage} ${name}${f.anreise ? ` ${f.anreise}` : ''}`;
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(betreff)}&body=${encodeURIComponent(zeilen.join('\n'))}`;
        status.textContent = texte.mailOeffnet;
      };
      if (form.dataset.versand === 'trizoun' && trizounApi && trizounKey && f.wohnung) {
        const knopf = form.querySelector('button[type="submit"]');
        knopf.disabled = true;
        status.textContent = texte.wirdGesendet;
        try {
          const res = await fetch(`${trizounApi}/v1/public/listings/${encodeURIComponent(slugs[f.wohnung] ?? f.wohnung)}/kontakt`, {
            method: 'POST',
            headers: { authorization: `Bearer ${trizounKey}`, 'content-type': 'application/json' },
            body: JSON.stringify({
              name: f.name,
              email: f.email,
              nachricht: f.nachricht,
              ...(f.anreise ? { anreise: f.anreise } : {}),
              ...(f.abreise ? { abreise: f.abreise } : {}),
              ...(f.gaeste ? { gaeste: Number(f.gaeste) } : {}),
              ...(kinder ? { kinder } : {}),
              // Einwilligung mit genau dem Wortlaut, den der Gast gesehen hat
              ...(f.angebote ? { angebote: true, angeboteText: form.querySelector('[data-angebote] span').textContent } : {}),
              website: f.website || '',
            }),
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok || !json.ok) throw new Error(json.error || `Fehler ${res.status}`);
          form.reset();
          status.textContent = texte.danke;
        } catch (err) {
          mailto();
          status.textContent = `${texte.nichtGeklappt} (${err.message}). ${texte.mailOeffnet}`;
        } finally {
          knopf.disabled = false;
        }
        return;
      }
      if (!endpunkt) {
        mailto();
        return;
      }
      const knopf = form.querySelector('button[type="submit"]');
      knopf.disabled = true;
      status.textContent = texte.wirdGesendet;
      try {
        const res = await fetch(endpunkt, { method: 'POST', body: JSON.stringify(f), headers: { 'Content-Type': 'application/json', Accept: 'application/json' } });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || !json.ok) throw new Error(json.meldung || `Fehler ${res.status}`);
        form.reset();
        status.textContent = texte.danke;
      } catch (err) {
        status.innerHTML = '';
        status.append(`${texte.nichtGeklappt} (${err.message}). `);
        const a = document.createElement('a');
        a.href = `mailto:${email}`;
        a.textContent = email;
        status.append(a);
      } finally {
        knopf.disabled = false;
      }
    });
  });
</script>

<style>
  .anfrage { display: grid; gap: .75rem; }
  .reihe { display: grid; grid-template-columns: 1fr 1fr; gap: .6rem; }
  .feld { display: grid; gap: .25rem; font-size: .95rem; }
  .feld :is(input, select, textarea) { font: inherit; padding: .55rem .7rem; border-radius: var(--radius); border: 1.5px solid var(--rule); background: var(--bg); color: var(--text); min-width: 0; }
  .feld :is(input, select, textarea):focus { outline: none; border-color: var(--accent); }
  .falle { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .hinweis { font-size: .85rem; color: var(--muted); margin: 0; }
  .haken { display: flex; gap: .55rem; align-items: flex-start; font-size: .9rem; line-height: 1.4; cursor: pointer; }
  .haken[hidden] { display: none; }
  .haken input { margin-top: .2rem; accent-color: var(--accent); }
  .status { margin: 0; min-height: 1.5em; }
  .btn { justify-self: start; }
</style>
