---
// Bild aus lokaler Datei (ImageMetadata) oder aus dem Trizoun-Katalog (URL).
// URLs werden beim Build heruntergeladen und wie lokale Bilder optimiert (Domain in astro.config.ts freigegeben).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: 'eager' | 'lazy';
  class?: string;
  style?: string;
}
const { src, ...rest } = Astro.props;
---

{typeof src === 'string' ? <Image src={src} inferSize {...rest} /> : <Image src={src} {...rest} />}
