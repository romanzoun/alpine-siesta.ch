---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titel: string[];
  untertitel: string;
  bild?: ImageMetadata;
  alt?: string;
  ctaHref: string;
  ctaLabel: string;
}
const { titel, untertitel, bild, alt, ctaHref, ctaLabel } = Astro.props;
---

<section class="hero">
  {bild ? (
    <Image src={bild} alt={alt ?? ''} widths={[800, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="hintergrund" />
  ) : (
    <svg class="hintergrund" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice" role="img" aria-label="Illustration: die Gemmiwand über Leukerbad im Abendlicht">
      <defs>
        <linearGradient id="himmel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#16233a" />
          <stop offset=".55" stop-color="#4b5878" />
          <stop offset=".85" stop-color="#f0b38c" />
        </linearGradient>
        <linearGradient id="wand" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#e9a98a" />
          <stop offset=".18" stop-color="#7d6f86" />
          <stop offset="1" stop-color="#2b3a56" />
        </linearGradient>
      </defs>
      <rect width="1600" height="900" fill="url(#himmel)" />
      <!-- Ferne Gipfel -->
      <path d="M0 520 L140 430 L250 470 L380 360 L470 420 L560 380 L640 440 L0 640Z M960 430 L1080 330 L1170 390 L1290 300 L1400 380 L1500 340 L1600 400 L1600 640 L960 640Z" fill="#5d6a8a" opacity=".7" />
      <!-- Gemmiwand: lange, senkrechte Kalkwand -->
      <path d="M0 470 L90 455 L180 380 L215 300 L300 285 L420 300 L520 280 L640 292 L760 270 L880 284 L1000 262 L1120 280 L1240 268 L1330 290 L1385 360 L1450 430 L1600 470 L1600 900 L0 900Z" fill="url(#wand)" />
      <path d="M215 300 L300 285 L420 300 L520 280 L640 292 L760 270 L880 284 L1000 262 L1120 280 L1240 268 L1330 290" fill="none" stroke="#ffd2b4" stroke-width="3" opacity=".8" />
      <!-- Felsbänder -->
      <g stroke="#1f2d47" stroke-width="2" opacity=".35" fill="none">
        <path d="M230 380 Q600 360 1340 375" /><path d="M200 450 Q700 425 1400 445" /><path d="M150 520 Q760 500 1480 520" />
      </g>
      <!-- Talboden und Dorf -->
      <path d="M0 700 Q300 640 620 690 Q900 735 1200 680 Q1420 645 1600 690 L1600 900 L0 900Z" fill="#16233a" />
      <g class="lichter" fill="#ffd9a8">
        <circle cx="610" cy="712" r="3" /><circle cx="642" cy="720" r="2.5" /><circle cx="680" cy="708" r="3" /><circle cx="720" cy="724" r="2.5" />
        <circle cx="760" cy="716" r="3" /><circle cx="800" cy="728" r="2" /><circle cx="845" cy="719" r="3" /><circle cx="890" cy="730" r="2.5" />
        <circle cx="700" cy="740" r="2" /><circle cx="780" cy="745" r="2.5" /><circle cx="860" cy="748" r="2" />
      </g>
    </svg>
  )}

  <div class="dampf" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>

  <div class="container text">
    <h1>{titel.map((zeile, i) => <span class="zeile" style={`--i:${i}`}><span>{zeile}</span></span>)}</h1>
    <p class="untertitel" style={`--i:${titel.length}`}>{untertitel}</p>
    <a class="btn" href={ctaHref} style={`--i:${titel.length + 1}`}>{ctaLabel}</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(92svh, 56rem);
    display: grid;
    align-items: end;
    color: var(--dampf);
    background: var(--nacht);
  }
  @media (max-width: 40rem) { .lichter { display: none; } }
  .hintergrund { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(22 35 58 / .85), rgb(22 35 58 / 0) 55%); }
  .text { position: relative; z-index: 2; padding-block: 4rem clamp(3rem, 8vw, 5rem); }

  h1 { font-size: clamp(3.4rem, 13vw, 10rem); line-height: .86; margin-bottom: 1.5rem; }
  .zeile { display: block; overflow: hidden; padding-bottom: .04em; }
  .zeile > span { display: block; animation: aufsteigen .9s var(--ease-out) both; animation-delay: calc(var(--i) * 140ms + 150ms); }
  .untertitel { font-size: clamp(1.1rem, 2vw, 1.3rem); max-width: 30rem; margin: 0 0 1.75rem; color: rgb(245 248 247 / .85); }
  .untertitel, .text .btn { animation: einblenden .8s var(--ease-out) both; animation-delay: calc(var(--i) * 140ms + 250ms); }
  .text .btn { background: var(--glut); color: var(--nacht); }

  @keyframes aufsteigen { from { transform: translateY(105%); } }
  @keyframes einblenden { from { opacity: 0; transform: translateY(.75rem); } }

  /* Thermaldampf: langsam aufsteigende, weiche Schwaden */
  .dampf { position: absolute; inset: auto 0 0; height: 70%; z-index: 1; pointer-events: none; }
  .dampf span {
    position: absolute;
    bottom: -20%;
    width: 38vmax;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(245 248 247 / .22), transparent);
    filter: blur(20px);
    animation: dampf 16s linear infinite;
    opacity: 0;
  }
  .dampf span:nth-child(1) { left: -8%; animation-delay: 0s; }
  .dampf span:nth-child(2) { left: 18%; animation-delay: -4s; animation-duration: 19s; }
  .dampf span:nth-child(3) { left: 42%; animation-delay: -9s; }
  .dampf span:nth-child(4) { left: 64%; animation-delay: -2s; animation-duration: 21s; }
  .dampf span:nth-child(5) { left: 82%; animation-delay: -12s; animation-duration: 18s; }
  @keyframes dampf {
    0% { transform: translateY(0) scale(.6); opacity: 0; }
    25% { opacity: 1; }
    100% { transform: translateY(-75%) translateX(4%) scale(1.25); opacity: 0; }
  }
</style>
