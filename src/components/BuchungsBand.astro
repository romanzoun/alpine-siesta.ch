---
// Dunkles Band mit Buchungsaufruf am Ende von Inhaltsseiten.
import { site } from '../config';
import { alleWohnungen, buchungsZiel } from '../lib/wohnungen';

const anzahl = (await alleWohnungen()).length;
const ziel = await buchungsZiel();
---

<section class="section band">
  <div class="container">
    <h2>Deine Unterkunft in {site.ort}</h2>
    <p class="lead">{anzahl === 1 ? 'Unsere Ferienwohnung' : 'Unsere Ferienwohnungen'} – direkt bei uns gebucht zum besten Preis.</p>
    <a class="btn" href={ziel}>Verfügbarkeit &amp; Preise</a>
  </div>
</section>
