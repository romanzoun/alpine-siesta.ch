---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  bilder: CollectionEntry<'wohnung'>['data']['galerie'];
}
const { bilder } = Astro.props;
---

<ul class="galerie">
  {bilder.map((b, i) => (
    <li class={i === 0 ? 'gross' : undefined}>
      <a href={b.bild.src}>
        <Image src={b.bild} alt={b.alt} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 50vw, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
      </a>
    </li>
  ))}
</ul>

<style>
  .galerie { list-style: none; padding: 0; margin: 0; display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(min(45%, 16rem), 1fr)); }
  .galerie .gross { grid-column: 1 / -1; }
  @media (min-width: 48rem) { .galerie .gross { grid-column: span 2; grid-row: span 2; } }
  .galerie img { width: 100%; height: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius); }
</style>
