---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  bilder: CollectionEntry<'wohnung'>['data']['galerie'];
}
const { bilder } = Astro.props;
---

<ul class="galerie">
  {bilder.map((b, i) => (
    <li>
      <a href={b.bild.src}>
        <Image src={b.bild} alt={b.alt} widths={[480, 800, 1400]} sizes={i === 0 ? '(min-width: 48rem) 66vw, 100vw' : '(min-width: 48rem) 33vw, 50vw'} loading={i === 0 ? 'eager' : 'lazy'} />
      </a>
      {b.raum && <span class="raum">{b.raum}</span>}
    </li>
  ))}
</ul>

<style>
  .galerie { list-style: none; padding: 0; margin: 0; display: grid; gap: .5rem; grid-template-columns: repeat(2, 1fr); }
  .galerie li { position: relative; overflow: hidden; border-radius: var(--radius); }
  .galerie li:first-child { grid-column: 1 / -1; }
  @media (min-width: 48rem) {
    .galerie { grid-template-columns: repeat(3, 1fr); }
    .galerie li:first-child { grid-column: span 2; grid-row: span 2; }
  }
  .galerie img { width: 100%; height: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform .6s var(--ease-out); }
  .galerie a:hover img { transform: scale(1.03); }
  .raum { position: absolute; left: .75rem; bottom: .6rem; color: #fff; font-size: .9rem; font-weight: 600; text-shadow: 0 1px 6px rgb(0 0 0 / .5); pointer-events: none; }
</style>
