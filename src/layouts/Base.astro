---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Einwilligung from '../components/Einwilligung.astro';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '../config';
import { getCollection } from 'astro:content';
import { buchungsZiel, wohnungenNav } from '../lib/wohnungen';
import { allePillars, hubUrl } from '../lib/pillars';
import { asLocale, htmlLang, locales, mitLocale, ohneLocale, type Locale } from '../i18n/config';
import { ui } from '../i18n/ui';
import { fusszeile, rechtText } from '../i18n/recht';

interface Props {
  title: string;
  description: string;
  // Vorschaubild für Social Media; ohne Angabe /og.jpg aus site/public/
  bild?: ImageMetadata;
  typ?: 'website' | 'article';
  // Entwürfe nie indexieren (falls sie versehentlich mitgebaut werden)
  noindex?: boolean;
  locale?: Locale;
  // Sprachen, in denen diese URL wirklich existiert. Der Reiseführer ist vorerst nur Deutsch.
  sprachen?: Locale[];
}
const { title, description, bild, typ = 'website', noindex = false } = Astro.props;
const sprachen = Astro.props.sprachen ?? [...locales];
const locale = asLocale(Astro.props.locale ?? Astro.currentLocale);
const ogBild = bild
  ? new URL((await getImage({ src: bild, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src, Astro.site).href
  : new URL('/og.jpg', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const t = ui(locale);
const wohnNav = await wohnungenNav();
const nav = [
  { href: mitLocale(locale, wohnNav.href), label: wohnNav.href.includes('/wohnungen/') && !wohnNav.href.endsWith('/wohnungen/') ? t.wohnung : t.wohnungen },
  ...((await allePillars()).length ? [{ href: mitLocale(locale, hubUrl()), label: site.ort }] : []),
  ...(site.module.entdecken ? [{ href: mitLocale(locale, '/entdecken/'), label: 'Entdecken' }] : []),
  ...site.nav.map((item) => ({ href: mitLocale(locale, item.href), label: item.label })),
  { href: mitLocale(locale, '/kontakt/'), label: t.kontakt },
];
const buchenZiel = await buchungsZiel(locale);
const seitenpfad = ohneLocale(path);
const rechtliches = (await getCollection('rechtliches')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {sprachen.map((sprache) => (
      <link rel="alternate" hreflang={htmlLang[sprache]} href={new URL(mitLocale(sprache, seitenpfad), Astro.site)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={new URL(mitLocale('de', seitenpfad), Astro.site)} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={typ} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={htmlLang[locale].replace('-', '_')} />
    {sprachen.filter((sprache) => sprache !== locale).map((sprache) => (
      <meta property="og:locale:alternate" content={htmlLang[sprache].replace('-', '_')} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogBild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a href={mitLocale(locale, '/')} class="logo" aria-label={site.name}><Logo /></a>
        <button type="button" class="menu" aria-expanded="false" aria-controls="hauptnav" aria-label={t.menu}>
          <span></span><span></span><span></span>
        </button>
        <nav id="hauptnav" aria-label={locale === 'en' ? 'Main' : locale === 'fr' ? 'Navigation' : locale === 'it' ? 'Navigazione' : 'Hauptnavigation'}>
          {nav.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
          <div class="sprachen" aria-label={t.sprache}>
            {sprachen.map((sprache) => (
              <a href={mitLocale(sprache, seitenpfad)} hreflang={htmlLang[sprache]} lang={htmlLang[sprache]} aria-current={sprache === locale ? 'true' : undefined}>{sprache.toUpperCase()}</a>
            ))}
          </div>
        </nav>
        <a class="btn" href={buchenZiel}>{t.buchen}</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <a href={mitLocale(locale, '/')} class="footer-logo" aria-label={site.name}><Logo /></a>
        <p>{fusszeile(locale, site.ort, site.region)}<br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <ul class="footer-links">
          {rechtliches.map((r) => <li><a href={mitLocale(locale, `/${r.id}/`)}>{rechtText(locale, r.id)?.title ?? r.data.title}</a></li>)}
          {(site.statistik.clarity || site.statistik.cloudflare) && <li><button type="button" class="footer-knopf" data-einwilligung-oeffnen>{t.statistikEinstellungen}</button></li>}
        </ul>
      </div>
    </footer>
    <Einwilligung locale={locale} />
    <script>
      import { textBild } from '../scripts/text-bild';
      const rhythmus = () => document.querySelectorAll<HTMLElement>('.guide .prose').forEach(textBild);
      rhythmus();
      document.addEventListener('astro:page-load', rhythmus);
    </script>
    <script>
      const knopf = document.querySelector('.menu');
      const nav = document.querySelector('#hauptnav');
      const setze = (offen: boolean) => {
        nav?.classList.toggle('offen', offen);
        knopf?.setAttribute('aria-expanded', String(offen));
      };
      knopf?.addEventListener('click', () => setze(!nav?.classList.contains('offen')));
      // Esc und Klick daneben schliessen das Menü
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape' || !nav?.classList.contains('offen')) return;
        setze(false);
        (knopf as HTMLElement | null)?.focus();
      });
      document.addEventListener('click', (e) => {
        if (nav?.classList.contains('offen') && !(e.target as Element).closest('.bar')) setze(false);
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'logo nav btn';
    align-items: center;
    gap: .5rem 1.5rem;
    padding-block: .75rem;
  }
  .logo { grid-area: logo; line-height: 0; text-decoration: none; }
  .logo :global(svg) { height: 4.6rem; width: auto; }
  nav { grid-area: nav; display: flex; justify-content: flex-end; gap: 1.25rem; overflow-x: auto; scrollbar-width: none; }
  nav a { color: var(--text); text-decoration: none; white-space: nowrap; }
  nav a { padding-block: .25rem; background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat; transition: background-size .25s var(--ease-out); }
  nav a:hover, nav a[aria-current='page'] { background-size: 100% 2px; }
  .sprachen { display: flex; gap: .7rem; align-items: center; }
  .sprachen a { text-decoration: none; color: var(--muted); font-weight: 650; background: none; }
  .sprachen a[aria-current='true'] { color: var(--accent); }
  .bar .btn { grid-area: btn; padding: .55rem 1.1rem; white-space: nowrap; }
  .menu {
    display: none;
    grid-area: menu;
    place-items: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: transparent;
    font-size: 0;
    cursor: pointer;
  }
  .menu span { display: block; width: 1.25rem; height: 2px; background: var(--text); }
  @media (max-width: 48rem) {
    .bar { grid-template-columns: auto 1fr auto; grid-template-areas: 'logo menu btn'; }
    .menu { display: grid; }
    nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: .25rem 1rem 1rem;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
    }
    nav.offen { display: flex; box-shadow: 0 1.5rem 2rem -1rem rgb(0 0 0 / .35); }
    nav a { padding: .8rem 0; border-bottom: 1px solid var(--rule); }
    nav .sprachen { gap: 0; }
    nav .sprachen a { border-bottom: 0; padding: .8rem 1.2rem .8rem 0; }
  }
  .site-footer { background: var(--band); color: var(--band-text); padding-block: 3rem 4rem; font-size: .95rem; border-top: 1px solid rgb(245 248 247 / .12); }
  .site-footer a { color: inherit; }
  .footer-logo { display: inline-block; line-height: 0; text-decoration: none; margin-bottom: 1.25rem; }
  .footer-logo :global(svg) { height: 9rem; width: auto; }
  .footer-links { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  /* Tippflächen mindestens 44 px hoch */
  .footer-links a, .site-footer p a { display: inline-block; padding-block: .7rem; }
  .footer-knopf { font: inherit; color: inherit; background: none; border: 0; padding: .7rem 0; text-decoration: underline; cursor: pointer; }
</style>
