---
import { dimensionen, themenseiten, themenUrl, themenH1, type DimensionKey } from '../dimensionen';
import type { Eintrag } from '../typen';

interface Props {
  eintraege: Eintrag[];
  aktuell?: string;
  /** Auf der Übersicht: Filter auf der geladenen Liste, kein zweiter Seitenaufruf. */
  lokal?: boolean;
}
const { eintraege, aktuell, lokal = false } = Astro.props;

const filterQuery = (d: DimensionKey, wert: string) => {
  const key = d === 'fuer' ? 'fuer' : d === 'saison' ? 'saison' : 'thema';
  return `/entdecken/?${key}=${encodeURIComponent(wert)}`;
};
const seiten = themenseiten(eintraege);
const gruppen = (Object.keys(dimensionen) as DimensionKey[])
  .map((d) => ({ d, seiten: seiten.filter((s) => s.d === d) }))
  .filter((g) => g.seiten.length);
---

{gruppen.length > 0 && (
  <nav class="themen liste" aria-label="Themen">
    {gruppen.map((g) => (
      <div>
        <h3>{dimensionen[g.d].name}</h3>
        <ul>
          {g.seiten.map((s) => {
            const href = lokal ? filterQuery(s.d, s.wert) : themenUrl(s.d, s.wert);
            return (
              <li>
                <a
                  href={href}
                  aria-current={href === aktuell ? 'page' : undefined}
                  data-set-filter={lokal ? s.d : undefined}
                  data-wert={lokal ? s.wert : undefined}
                  data-ersetzen={lokal ? 'ja' : undefined}
                >{themenH1(s.d, s.wert)}</a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
)}

<style>
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .35rem; }
  a[aria-current] { color: var(--text); font-weight: 650; text-decoration: none; }
</style>
