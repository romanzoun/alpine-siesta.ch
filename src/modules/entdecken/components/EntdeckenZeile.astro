---
import { bildUrl } from '../api';
import { asLocale, mitLocale } from '../../../i18n/config';
import { entdeckenUi } from '../ui';
import { naechsterTermin, terminText } from '../termine';
import type { Eintrag } from '../typen';
import { themenUrl } from '../dimensionen';

interface Props {
  eintrag: Eintrag;
  /** Klickbare Tags in der Zeile (Übersicht). */
  tags?: boolean;
  /** Tags filtern die schon geladene Liste, ohne neue Seite. */
  tagsLokal?: boolean;
  sprache?: string;
}
const { eintrag: e, tags = true, tagsLokal = false, sprache = 'de' } = Astro.props;
const t = entdeckenUi(sprache);
const termin = e.typ === 'event' ? naechsterTermin(e) : undefined;
const href = mitLocale(asLocale(sprache), `/entdecken/${e.slug}/`);
const chipThemen = e.kategorien.slice(0, 3);
---

<article class="zeile">
  <a class="bild-link" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={bildUrl(e.slug)}
      alt=""
      width="160"
      height="120"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="text">
    <h3>
      <a href={href}>{e.title}</a>
    </h3>
    <p class="kurz">{e.kurz}</p>
    {termin ? (
      <p class="meta"><strong class="termin">{terminText(termin)}</strong>{e.veranstaltungsort && `, ${e.veranstaltungsort}`}</p>
    ) : (
      <p class="meta">{t.dauer[e.dauer as keyof typeof t.dauer] ?? e.dauer}, {e.anreise_min} min {e.anreise_wie}</p>
    )}
    {tags && (
      <ul class="tags">
        {chipThemen.map((k) => {
          const label = t.kategorien[k as keyof typeof t.kategorien] ?? k;
          return (
            <li>
              {tagsLokal ? (
                <button type="button" data-set-filter="thema" data-wert={k}>{label}</button>
              ) : (
                <a href={mitLocale(asLocale(sprache), themenUrl('thema', k))}>{label}</a>
              )}
            </li>
          );
        })}
        {e.geheimtipp && <li><span class="geheim">Geheimtipp</span></li>}
      </ul>
    )}
    {e.bildQuelle && (
      <p class="bildnachweis">
        {e.bildKi ? 'KI-Illustration: ' : 'Foto: '}
        {e.bildQuelle.urheber && `${e.bildQuelle.urheber}, `}
        <a href={e.bildQuelle.url} rel="nofollow noopener" target="_blank">{e.bildQuelle.name}</a>
        {e.bildQuelle.lizenz && ` · ${e.bildQuelle.lizenz}`}
      </p>
    )}
  </div>
</article>

<style>
  .zeile {
    display: grid;
    gap: 1rem 1.25rem;
    grid-template-columns: 7.5rem 1fr;
    align-items: start;
    position: relative;
  }
  .bild-link {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 3;
    background: var(--rule);
  }
  .bild-link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s var(--ease-out);
  }
  .zeile:hover .bild-link img { transform: scale(1.04); }
  @media (prefers-reduced-motion: reduce) {
    .bild-link img { transition: none; }
    .zeile:hover .bild-link img { transform: none; }
  }
  h3 { margin: 0; font-size: 1.25rem; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  .zeile:hover h3 a { text-decoration: underline; text-decoration-thickness: 2px; }
  .kurz, .meta, .bildnachweis { margin: .35rem 0 0; }
  .kurz { color: var(--muted); }
  .meta { font-size: .9rem; color: var(--muted); }
  .termin { color: var(--accent); font-weight: 650; }
  .tags {
    list-style: none;
    padding: 0;
    margin: .55rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: .35rem;
    position: relative;
    z-index: 1;
  }
  .tags a, .tags button, .geheim {
    display: inline-block;
    padding: .2rem .55rem;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1.5px var(--rule);
    font-size: .85rem;
    color: var(--text);
    text-decoration: none;
  }
  .tags button { font: inherit; background: none; border: 0; cursor: pointer; }
  .tags a:hover, .tags button:hover { box-shadow: inset 0 0 0 1.5px var(--text); }
  .bildnachweis { font-size: .75rem; line-height: 1.3; color: var(--muted); position: relative; z-index: 1; }
  @media (max-width: 30rem) {
    .zeile { grid-template-columns: 5.5rem 1fr; gap: .75rem; }
  }
</style>
