# Intern im Docker-Netz. TLS und Kompression macht der vordere Caddy (Trizoun, deploy/Caddyfile).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	# Dateinamen mit Hash: dauerhaft cachen
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
